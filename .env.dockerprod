# docker 容器化 prod 环境：构建方式 `pnpm exec vite build --mode dockerprod`
# 生产部署由 web 容器 nginx 作统一入口（:8080）反代：
#   /prod-api/* -> server:48080（重写为 /admin-api）
#   /qwenpaw/*  -> qwenpaw:8088
#   其余        -> 前端静态资源
# 故 VITE_BASE_URL 留空（同源），API 前缀用 /prod-api 以命中 nginx 反代规则。
NODE_ENV=production

VITE_DEV=false

# 请求路径：留空 = 同源，走 nginx 反代
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传
VITE_UPLOAD_TYPE=server

# 接口地址（nginx 反代 server:48080 时的前缀）
VITE_API_URL=/prod-api

# 是否删除debugger/console
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false

# 是否开启压缩
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 验证码关闭（容器内避免额外依赖）
VITE_APP_CAPTCHA_ENABLE=false

# API 加解密（保持默认关闭，避免与 nginx/后端加解密配置不一致导致异常）
VITE_APP_API_ENCRYPT_ENABLE=false