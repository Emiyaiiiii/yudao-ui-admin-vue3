# docker 容器化 dev 环境：启动方式 `pnpm exec vite --mode docker`
# 容器内由 deploy/nginx/dev.conf 统一反代（:8080）：
#   /admin-api/* -> server:48080，其余 -> frontend:5999
# 故 VITE_BASE_URL 留空（同源），浏览器请求相对路径 /admin-api，经 nginx 转发到后端。
NODE_ENV=development

VITE_DEV=true

# 请求路径：留空 = 同源，走 nginx 反代
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传
VITE_UPLOAD_TYPE=server

# 接口地址（nginx 反代 server:48080 时保留该前缀）
VITE_API_URL=/admin-api

# 是否删除debugger/console
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true

# 是否开启压缩
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 验证码关闭（容器内避免额外依赖）
VITE_APP_CAPTCHA_ENABLE=false

# API 加解密（保持默认关闭，避免与 nginx/后端加解密配置不一致导致异常）
VITE_APP_API_ENCRYPT_ENABLE=false